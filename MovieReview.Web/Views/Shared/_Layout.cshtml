<!DOCTYPE html>
<html lang="en" ng-app="homeIndex">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Movie Review</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Styles -->
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body class="homepage">

    <!-- Header -->
    <div id="header-wrapper">
        <div class="container">
            <header id="header">
                <div class="inner">
                    <h1><a href="#/">Movie Review</a></h1>
                    <nav id="nav">
                        <ul>
                            <li><a href="#/">Home</a></li>
                            <li><a href="#/movies">Movies</a></li>
                        </ul>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <!-- Main Content -->
    <div id="main-wrapper">
        <div class="wrapper style3">
            <div class="inner">
                <div class="container">
                    <div class="row">
                        <div class="8u">
                            <!-- Angular View -->
                            <section class="box article-list" ng-view></section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div id="footer-wrapper">
        <footer id="footer" class="container">
            <div class="row">
                <div class="12u">
                    <section>
                        <h2><strong>Movie Review</strong> by Rahul Sahay</h2>
                        <p>
                            Hi! This is <strong>Rahul</strong>, I made this app using ASP.NET MVC 5,
                            Entity Framework, AngularJS, HTML5, and design patterns like SOLID,
                            Unit of Work, and Repository Pattern.
                        </p>
                        <a href="http://myview.rahulnivi.net" class="button alt icon fa-arrow-circle-right">
                            Learn More
                        </a>
                    </section>

                    <section>
                        <h2>Get in touch</h2>
                        <dl class="contact">
                            <dt>Twitter</dt>
                            <dd><a href="https://twitter.com/rahulsahay19">@@rahulsahay19</a></dd>
                            <dt>Facebook</dt>
                            <dd><a href="https://www.facebook.com/rahulsahay19">Rahul Sahay</a></dd>
                            <dt>Blog</dt>
                            <dd><a href="http://myview.rahulnivi.net">My View</a></dd>
                            <dt>LinkedIn</dt>
                            <dd><a href="http://in.linkedin.com/in/rahulsahay19/">My Profile</a></dd>
                        </dl>
                    </section>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <!-- AngularJS core -->
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>

    <!-- App scripts -->
    <script src="~/Scripts/init.js"></script>
    <script src="~/js/home-index.js"></script>
    <script src="~/js/home-movie-edit.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
