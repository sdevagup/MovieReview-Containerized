<!DOCTYPE html>
<html lang="en" data-ng-app="@ViewBag.InitModule">
<head>
    <title>Movie Review</title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="description" content="" />
    <meta name="keywords" content="" />

    <!-- Core CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/style-desktop.css" rel="stylesheet" />
    <link href="~/Content/style-mobile.css" rel="stylesheet" />

    <!-- Modernizr -->
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
</head>
<body class="homepage" ng-cloak>

    <!-- Header -->
    <div id="header-wrapper">
        <div class="container">
            <header id="header">
                <div class="inner">
                    <h1><a href="#/">MOVIE REVIEW</a></h1>
                    <nav id="nav">
                        <ul>
                            <li><a href="#/">Home</a></li>
                            <li><a href="#/movies">Movies</a></li>
                        </ul>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <!-- Main -->
    <div id="main-wrapper">
        <div class="wrapper style3">
            <div class="inner">
                <div class="container">
                    <div class="row">
                        <div class="8u">
                            <section class="box article-list">
                                @RenderBody()
                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div id="footer-wrapper">
        <footer id="footer" class="container">
            <div class="row">
                <div class="12u">
                    <section>
                        <h2><strong>Movie Review</strong> by Rahul Sahay</h2>
                        <p>
                            Hi! This is <strong>Rahul</strong>, I made this app using ASP.NET MVC 5, Entity Framework, and AngularJS.
                            It's a significant effort to build a <strong>Single Page App</strong> using these technologies.
                        </p>
                    </section>
                </div>
            </div>
            <div class="row">
                <div class="12u">
                    <div id="copyright">
                        <ul class="menu">
                            <li>&copy; Movie Review. All rights reserved</li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-2.1.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    <!-- Angular and SPA Scripts -->
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/angular-sanitize.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/init.js"></script>
    <script src="~/Scripts/home-index.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>